# Copy to .env and fill in real values for local/dev use. Never commit the
# real .env file (it is already listed in .gitignore).

DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALLOWED_HOSTS=127.0.0.1,localhost

# Database (MySQL in Docker/production; can be overridden to sqlite for tests)
DB_ENGINE=mysql
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_DATABASE=srt_transport
MYSQL_USER=root
MYSQL_PASSWORD=Bhanu@2000

# Full SQLAlchemy URL is assembled from the above unless DATABASE_URL is set
# explicitly, e.g. for local (non-Docker) MySQL on 127.0.0.1:
# DATABASE_URL=mysql+pymysql://root:Bhanu%402000@127.0.0.1:3306/srt_transport
